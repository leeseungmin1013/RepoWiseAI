APP_ENV=development
SERVICE_NAME=repowise-api
RELEASE_SHA=local
DATABASE_URL=postgresql+psycopg://repowise:repowise@localhost:5432/repowise
MIGRATION_DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
HEALTHCHECK_TIMEOUT_SECONDS=2
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ANALYSIS_WORKSPACE=.data/repositories
GITHUB_TOKEN=
OPENAI_API_KEY=
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768
GENERATION_PROVIDER=auto
GENERATION_MODEL=gpt-5.4-mini
REALTIME_MODEL=gpt-realtime-2.1-mini
REALTIME_TRANSCRIPTION_MODEL=gpt-realtime-whisper
REALTIME_TRANSCRIPTION_DELAY=low
REALTIME_VOICE=marin
REALTIME_LANGUAGE=ko
REALTIME_REASONING_EFFORT=minimal
REALTIME_API_URL=https://api.openai.com/v1/realtime/calls
REALTIME_CONNECT_TIMEOUT_SECONDS=10
REALTIME_REQUEST_TIMEOUT_SECONDS=30
REALTIME_MAX_SDP_BYTES=65536
DEEP_MODEL=gpt-5.6-terra
DEEP_REASONING_EFFORT=medium
DEEP_ESCALATION_MODEL=gpt-5.6-sol
DEEP_ESCALATION_REASONING_EFFORT=high
DEEP_TASK_TIMEOUT_SECONDS=180
DEEP_QUEUE_NAME=repowise-deep-learning
QUEUE_RECOVERY_STALE_SECONDS=900
QUEUE_RECOVERY_BATCH_SIZE=500
RESEARCH_MODEL=gpt-5.6-terra
RESEARCH_REASONING_EFFORT=medium
RESEARCH_ALLOWED_DOMAINS=developers.openai.com,docs.python.org,developer.mozilla.org,react.dev,nextjs.org,typescriptlang.org,nodejs.org,fastapi.tiangolo.com,docs.sqlalchemy.org,postgresql.org,redis.io,python-rq.org,docs.docker.com,git-scm.com
RESEARCH_MAX_SOURCES=5
CHUNK_MAX_LINES=160
CHUNK_OVERLAP_LINES=20
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_K=24
MAX_REPOSITORY_FILES=5000
MAX_REPOSITORY_BYTES=31457280
MAX_FILE_BYTES=1048576
MAX_ARCHIVE_BYTES=52428800
ANALYSIS_JOB_TIMEOUT_SECONDS=600
NAVIGATION_ARCHITECTURE_GRAPH_ENABLED=true
NAVIGATION_LLM_LABELS_ENABLED=false
# Supabase Auth / organization ownership
AUTH_REQUIRED=false
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=
SUPABASE_JWKS_TTL_SECONDS=600
DEFAULT_ORGANIZATION_ID=

# Snapshot / incremental analysis cache
EXACT_SNAPSHOT_REUSE_ENABLED=true
INCREMENTAL_ANALYSIS_ENABLED=true
INCREMENTAL_ANALYSIS_THRESHOLD=0.30
ANALYSIS_FINGERPRINT_VERSION=analysis-v1
FILE_FILTER_VERSION=source-filter-v1
CHUNKER_VERSION=chunker-v1
EMBEDDING_PROMPT_VERSION=embedding-prompt-v1
RETRIEVAL_INDEX_SCHEMA_VERSION=retrieval-v1
NAVIGATION_ARTIFACT_BUNDLE_VERSION=navigation-v1

# Tenant-safe semantic cache
SEMANTIC_CACHE_READ_ENABLED=true
SEMANTIC_CACHE_WRITE_ENABLED=true
SEMANTIC_CACHE_SHADOW_MODE=false
RETRIEVAL_CACHE_SIMILARITY_THRESHOLD=0.92
GENERATION_CACHE_SIMILARITY_THRESHOLD=0.96
RETRIEVAL_CACHE_TTL_DAYS=90
GENERATION_CACHE_TTL_DAYS=30

# Usage ledger / quota. Roll out as off -> shadow -> enforce.
QUOTA_ENFORCEMENT_MODE=off
DEFAULT_MONTHLY_ALLOWANCE_MICRO_USD=250000
USAGE_RESERVATION_TTL_SECONDS=900
CHAT_GENERATION_RESERVATION_MICRO_USD=100000
REPOSITORY_ANALYSIS_RESERVATION_MICRO_USD=1000000
DEEP_TASK_RESERVATION_MICRO_USD=500000
REALTIME_RESERVATION_MICRO_USD=250000
REALTIME_MAX_DURATION_SECONDS=300
