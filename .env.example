APP_ENV=development
DATABASE_URL=postgresql+psycopg://repowise:repowise@localhost:5432/repowise
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ANALYSIS_WORKSPACE=.data/repositories
GITHUB_TOKEN=
OPENAI_API_KEY=
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768
GENERATION_PROVIDER=auto
GENERATION_MODEL=gpt-5.4-mini
REALTIME_MODEL=gpt-realtime-2.1-mini
REALTIME_TRANSCRIPTION_MODEL=gpt-realtime-whisper
REALTIME_TRANSCRIPTION_DELAY=low
REALTIME_VOICE=marin
REALTIME_LANGUAGE=ko
REALTIME_REASONING_EFFORT=minimal
REALTIME_API_URL=https://api.openai.com/v1/realtime/calls
REALTIME_CONNECT_TIMEOUT_SECONDS=10
REALTIME_REQUEST_TIMEOUT_SECONDS=30
REALTIME_MAX_SDP_BYTES=65536
DEEP_MODEL=gpt-5.6-terra
DEEP_REASONING_EFFORT=medium
DEEP_ESCALATION_MODEL=gpt-5.6-sol
DEEP_ESCALATION_REASONING_EFFORT=high
DEEP_TASK_TIMEOUT_SECONDS=180
DEEP_QUEUE_NAME=repowise-deep-learning
RESEARCH_MODEL=gpt-5.6-terra
RESEARCH_REASONING_EFFORT=medium
RESEARCH_ALLOWED_DOMAINS=developers.openai.com,docs.python.org,developer.mozilla.org,react.dev,nextjs.org,typescriptlang.org,nodejs.org,fastapi.tiangolo.com,docs.sqlalchemy.org,postgresql.org,redis.io,python-rq.org,docs.docker.com,git-scm.com
RESEARCH_MAX_SOURCES=5
CHUNK_MAX_LINES=160
CHUNK_OVERLAP_LINES=20
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_K=24
MAX_REPOSITORY_FILES=5000
MAX_REPOSITORY_BYTES=31457280
MAX_FILE_BYTES=1048576
MAX_ARCHIVE_BYTES=52428800
ANALYSIS_JOB_TIMEOUT_SECONDS=600
NAVIGATION_ARCHITECTURE_GRAPH_ENABLED=true
NAVIGATION_LLM_LABELS_ENABLED=false
