{
  "name": "repowise-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev:api": "uv run --project apps/api uvicorn app.main:app --reload --port 8000",
    "dev:worker": "uv run --project apps/api python -m app.workers.runner",
    "dev:web": "pnpm --filter @repowise/web dev",
    "build:web": "pnpm --filter @repowise/web build",
    "lint:web": "pnpm --filter @repowise/web lint",
    "test:web": "pnpm --filter @repowise/web test",
    "lint:api": "uv run --project apps/api ruff check apps/api",
    "test:api": "uv run --project apps/api pytest -q",
    "eval:retrieval": "uv run --project apps/api python -m app.evaluation.retrieval",
    "eval:navigation": "uv run --project apps/api python -m app.evaluation.navigation",
    "eval:architecture": "uv run --project apps/api python -m app.evaluation.architecture",
    "eval:story": "uv run --project apps/api python -m app.evaluation.repository_story",
    "db:migrate": "uv run --project apps/api python -m app.migrate",
    "maintenance": "uv run --project apps/api python -m app.workers.maintenance",
    "smoke:container": "powershell -File scripts/container-smoke.ps1"
  },
  "devDependencies": {
    "supabase": "2.115.0"
  }
}
